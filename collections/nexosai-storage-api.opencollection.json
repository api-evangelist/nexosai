{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nexos AI Public API Production Agent Management Storage API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List uploaded media files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nexos.ai/v1/storage",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "A cursor for use in pagination. after is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "A limit on the number of objects to be returned. Limit can range between 1 and 10,000, and the default is 10,000."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order by the created_at timestamp of the objects. asc for ascending order and desc for descending order."
              },
              {
                "name": "purpose",
                "value": "",
                "type": "query",
                "description": "Only return files with the given purpose."
              }
            ]
          },
          "docs": "List uploaded files."
        },
        {
          "info": {
            "name": "Upload media file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nexos.ai/v1/storage",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Upload a media file for later use."
        },
        {
          "info": {
            "name": "Get storage file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nexos.ai/v1/storage/:file_id",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path",
                "description": "The ID of the file to use for this request."
              }
            ]
          },
          "docs": "Retrieve file details by ID."
        },
        {
          "info": {
            "name": "Delete storage file",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.nexos.ai/v1/storage/:file_id",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a file by ID."
        },
        {
          "info": {
            "name": "Get storage file contents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nexos.ai/v1/storage/:file_id/content",
            "params": [
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download file contents by ID."
        }
      ]
    }
  ],
  "bundled": true
}